# Engine HTTP port. The dashboard proxies to this.
NIGHTFILL_PORT=8788

# Optional live reference price. Defaults to the wNEAR price from the 1Click token list.
# Set to a decimal such as 3.22 to freeze the oracle for a recording.
NIGHTFILL_REFERENCE_PRICE=

# How often the engine crosses the dark book, in milliseconds.
NIGHTFILL_BATCH_MS=20000

# NEAR testnet anchoring. Leave unset to run fully locally.
# The key never belongs in git.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
NIGHTFILL_CONTRACT_ID=
NEAR_RPC_URL=https://rpc.testnet.near.org

# Account inside NEAR Intents used as the dry-quote recipient and refund address.
# Dry quotes do not move funds. Do not point this at an account you do not control
# if you later turn a quote into a real swap.
NIGHTFILL_INTENTS_ACCOUNT=nightfill.near

# Optional 1Click partner JWT. Without it, confidential quotes are refused by the
# API and Nightfill requests a public dry quote instead.
# https://partners.near-intents.org
ONECLICK_JWT=

# MCP agent identity. Hex Ed25519 secret key (64-byte expanded key, 128 hex chars).
# If unset, the MCP server creates one at .data/mcp-agent.json (gitignored).
NIGHTFILL_AGENT_SECRET=
NIGHTFILL_ENGINE_URL=http://127.0.0.1:8788
